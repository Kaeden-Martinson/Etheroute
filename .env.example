# ── Etheroute configuration ──────────────────────────────────────────────────
# Copy to .env and fill in. The app refuses to start in production if any
# required secret is missing, too short, or set to a known placeholder.

# development | production
NODE_ENV=development
PORT=3000
# Behind nginx/Caddy on the same machine, listen for the proxy alone so port
# 3000 is not reachable over plain HTTP from outside. Default: every interface.
# HOST=127.0.0.1

# The public origin, for the absolute URLs link previews need (og:image).
# Unset, it is taken from each request's scheme and host, which is right
# behind a proxy that sets X-Forwarded-Proto with TRUST_PROXY=true.
# SITE_URL=https://your-domain.com

# ── Required secrets ─────────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32

# Signs session tokens. Rotating it logs everyone out.
JWT_SECRET=

# Encrypts wallet private keys and seed phrases at rest, and derives webhook
# signing secrets.
#
# BACK THIS UP. If it is lost, every stored wallet key becomes unrecoverable
# and any funds at those addresses are gone. Store it in a secrets manager,
# not in this file, once you are past local development.
KEY_ENCRYPTION_KEY=

# How long a session token stays valid.
JWT_EXPIRES_IN=7d

# ── Network ──────────────────────────────────────────────────────────────────

# Set to true when running behind a load balancer or reverse proxy, so client
# IPs and the https flag are read from the forwarded headers. Leave false
# otherwise - trusting these headers without a proxy in front lets clients
# spoof their own IP and bypass rate limits.
TRUST_PROXY=false

# Comma-separated origins allowed to call the API from a browser. Leave empty
# for same-origin only, which is correct when the dashboard and API share a host.
# CORS_ORIGINS=https://app.example.com,https://example.com

# ── EVM RPC endpoints ────────────────────────────────────────────────────────

# One variable per EVM chain, comma-separated, tried in order. The app probes
# each one and uses the first that answers, so a dead endpoint is skipped
# rather than breaking every operation on that chain. Leave unset to use the
# built-in public list from src/config/chains.js.
#
# Public endpoints rate-limit (1rpc.io has a daily free quota) and are
# sometimes blocked by router or corporate DNS filtering (the symptom is a TLS
# certificate error naming a block page). For production, point each at a paid
# endpoint - Alchemy, Infura and QuickNode all serve every chain below.
# ETH_RPC_URLS=https://mainnet.infura.io/v3/YOUR_KEY,https://1rpc.io/eth
# POL_RPC_URLS=
# BASE_RPC_URLS=
# ARB_RPC_URLS=
# OP_RPC_URLS=
# BNB_RPC_URLS=
# AVAX_RPC_URLS=

# ── Rate limits (requests per minute) ────────────────────────────────────────

# Coarse per-IP ceiling, applied before authentication. A flood guard.
RATE_LIMIT_PER_IP_PER_MINUTE=600

# Each account's own budget, applied after authentication. This is the one to
# raise for an integration partner that legitimately polls hard - it is keyed
# by API key, so a partner calling from one server address gets its own bucket
# rather than sharing the IP ceiling with everyone behind the same NAT.
RATE_LIMIT_PER_CLIENT_PER_MINUTE=300

# Withdrawal creation and preview, per account.
RATE_LIMIT_WITHDRAWALS_PER_MINUTE=5

# The public checkout page's endpoints, per buyer IP. The page polls every 10s.
RATE_LIMIT_CHECKOUT_PER_IP_PER_MINUTE=60

# ── Third-party APIs ─────────────────────────────────────────────────────────

# Etherscan v2, the transaction index for Ethereum and most EVM chains: how
# checkout finds an incoming payment and the dashboard lists a wallet's
# history. Free to register; the free tier is 5 requests/second, 100k/day.
# Without a key the Etherscan sources are skipped (chains with a Blockscout
# or Routescan index still answer) and the server says so once at start.
# ETHERSCAN_API_KEY=

# CoinGecko demo key. Optional - raises the price-feed rate limit from ~10/min
# to 30/min. The app only polls once a minute, so this matters only if several
# instances share an egress address.
# COINGECKO_API_KEY=

# Refuse to price a new checkout or quote a withdrawal when the cached rates
# are older than this. Protects against quoting a stale price during a
# CoinGecko outage.
PRICE_MAX_AGE_MINUTES=15

# ── Keeping up with the chains ───────────────────────────────────────────────

# Every wallet's balance is read again on a rolling sweep: each tick, the
# stalest wallets (a bounded batch, a few at a time) whose figure is older
# than BALANCE_STALE_MS - or thirty seconds, with a transaction in flight.
# Money the platform moves itself is read at once, sweep or no sweep.
# BALANCE_SWEEP_INTERVAL_MS=60000
# BALANCE_STALE_MS=180000
# BALANCE_SWEEP_BATCH=25

# 1rpc.io serves fourteen of the chains' endpoints and meters free use per
# address per day; the health sweep and the balance sweep spend a share of
# that. A key (free to register at 1rpc.io) puts its allowance behind every
# 1rpc.io URL in the registry.
# ONE_RPC_KEY=

# How often every chain's endpoints, tip and swap routes are probed for the
# status page (and for alerts, with ALERT_WEBHOOK_URL).
# CHAIN_HEALTH_INTERVAL_MS=300000

# ── Swaps ────────────────────────────────────────────────────────────────────

# THORChain: cross-chain swaps with no custodian. The public node THORChain
# ran went dark in 2026; Liquify's gateway serves the same API keyless and is
# the default. Point these at your own node to stop depending on anyone.
# THORNODE_URL=https://gateway.liquify.com/chain/thorchain_api/thorchain
# MIDGARD_URL=https://gateway.liquify.com/chain/thorchain_midgard/v2

# Which cross-chain provider wins when both serve a pair. "best" (the
# default) takes whichever pays more for that withdrawal. Naming one takes
# it whenever it serves the pair - "thorchain" for a no-custodian policy -
# with the other as the fallback when it refuses.
# CROSS_CHAIN_PREFER=best

# A THORName earns basis points on every swap that goes through THORChain,
# paid by the network out of the swap. Optional; nothing is charged without.
# THORCHAIN_AFFILIATE=
# THORCHAIN_AFFILIATE_BPS=0

# BlockCypher serves Dogecoin's balances, unspent outputs and broadcasts.
# Its free tier is a few hundred requests an hour per address without a
# token; a free token lifts that.
# BLOCKCYPHER_TOKEN=

# The gas float: a platform wallet (one key, the same address on every EVM
# chain) that advances the coin a token-only wallet needs to send its USDC or
# USDT, moments before the send, charged back in the token at par on the same
# withdrawal. Fund the address on the chains you take tokens on. Without it,
# a wallet holding tokens but no coin is told what it is missing and its
# tokens stay put.
# GAS_FLOAT_PRIVATE_KEY=

# Set to "off" to bypass proxies/proxies.json entirely. When on, explorer and
# RPC reads rotate across the proxies listed there; proxies that fail are
# sidelined for ten minutes and the request goes direct.
PROXY_MODE=on

# ── Checkout ─────────────────────────────────────────────────────────────────

CHECKOUT_TTL_MINUTES=60

# Confirmations required before a payment settles as PAID. Lower means faster
# checkout and more reversal risk. Defaults per chain live in
# src/config/chains.js; set CONFIRMATIONS_<CODE> to override any of them.
CONFIRMATIONS_BTC=1
CONFIRMATIONS_LTC=2
CONFIRMATIONS_ETH=3
CONFIRMATIONS_SOL=1
# CONFIRMATIONS_POL=20
# CONFIRMATIONS_BASE=3
# CONFIRMATIONS_ARB=3
# CONFIRMATIONS_OP=3
# CONFIRMATIONS_BNB=3
# CONFIRMATIONS_AVAX=3

# Accept payments within this fraction of the requested amount (0.01 = 1% short).
CHECKOUT_UNDERPAYMENT_TOLERANCE=0.01

# ── Payouts ──────────────────────────────────────────────────────────────────

PLATFORM_FEE_RATE=0.05

# Where the platform's fee is collected to: one address per family. The EVM
# address serves every EVM chain. On Bitcoin-style chains the fee rides in
# the withdrawal itself as a second output; elsewhere it is held in the
# merchant's wallet and swept to the address once it is worth a transaction
# (over FEE_COLLECT_MIN_USD and FEE_COLLECT_GAS_MULTIPLE times the gas),
# daily and with `node scripts/collect-fees.js`. A family with no address
# keeps holding.
# PLATFORM_FEE_ADDRESS_EVM=
# PLATFORM_FEE_ADDRESS_BTC=
# PLATFORM_FEE_ADDRESS_LTC=
# PLATFORM_FEE_ADDRESS_BCH=
# PLATFORM_FEE_ADDRESS_DOGE=
# PLATFORM_FEE_ADDRESS_SOL=
# PLATFORM_FEE_ADDRESS_XRP=
# FEE_COLLECT_MIN_USD=10
# FEE_COLLECT_GAS_MULTIPLE=20
# A wallet a merchant closes is emptied with no dollar floor, once what is
# left is worth this many times its gas.
# FEE_COLLECT_CLOSED_GAS_MULTIPLE=2
# Sweep interval in ms (default 24h). 0 leaves collection to the CLI.
# FEE_COLLECT_INTERVAL_MS=86400000

# A transfer that has not been seen on its network for this many minutes is
# failed out, so it stops blocking the wallet from future withdrawals. A
# transfer the chain still reports as pending is never reaped - its funds are
# committed and it will confirm or be refunded on the network's own schedule.
STUCK_TRANSACTION_MINUTES=60

# ── Webhooks ─────────────────────────────────────────────────────────────────

WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=6

# ── Storage ──────────────────────────────────────────────────────────────────

# Where database.sqlite lives (and its backups/ folder). Defaults to ./data
# The first start with a database.json from an older build imports it once.
# DATA_DIR=/var/lib/etheroute

# Usage rows (one per authenticated request) are written a couple of seconds
# at a time in one commit, and kept for this many days. 0 keeps them forever.
# USAGE_FLUSH_MS=2000
# USAGE_RETENTION_DAYS=30

LOG_LEVEL=info

# ── Backups ──────────────────────────────────────────────────────────────────
# Timestamped snapshots are written to <DATA_DIR>/backups on a schedule and
# pruned to the most recent BACKUP_KEEP. Restore with: node scripts/restore.js
BACKUP_KEEP=14
# Snapshot interval in ms (default 24h). Set to 0 to disable scheduled snapshots.
# BACKUP_INTERVAL_MS=86400000

# ── Alerting ─────────────────────────────────────────────────────────────────
# If set, the server posts here when it starts, on unexpected 5xx errors and
# crashes, when a chain goes down or comes back, and after each fee sweep. A
# Discord webhook gets embeds (a colour per level, fields, stacks as code), a
# Slack webhook attachments, any other endpoint the raw JSON. Blank disables.
# ALERT_WEBHOOK_URL=
# Minimum ms between identical alerts, to avoid flooding the channel.
# ALERT_COOLDOWN_MS=60000

# ── Discord bot ──────────────────────────────────────────────────────────────
# A separate process (npm run discord) on one server: a verification panel
# whose button gives the Member role, a welcome in #welcome, an anti-bot
# channel that removes whoever posts in it, and the usual moderation
# commands. Setup and every key: discord/README.md.
# The token is the only secret. Developer Portal → Bot → Reset Token. If it
# has ever been pasted anywhere but here, reset it again.
# DISCORD_BOT_TOKEN=
# The server (right-click it → Copy Server ID) and the application id
# (General Information → Application ID; only used for the invite link).
# DISCORD_GUILD_ID=
# DISCORD_CLIENT_ID=
# Channels and the role, by name (emoji, dashes and case are ignored; a
# comma list tries each) or by id. These are the defaults.
# DISCORD_WELCOME_CHANNEL=welcome,welcomes,hello
# DISCORD_VERIFY_CHANNEL=verify,verification,verify-here
# DISCORD_ANTIBOT_CHANNEL=anti-bot,antibot,anti-spam,bot-trap
# DISCORD_LOG_CHANNEL=mod-log,mod-logs,modlog,logs,audit-log
# DISCORD_RULES_CHANNEL=rules,info
# DISCORD_STATUS_CHANNEL=status,service-status,uptime
# DISCORD_ROLES_CHANNEL=roles,get-roles,self-roles,role-select,pick-roles,claim-roles
# DISCORD_MEMBER_ROLE=Member
# The roles people claim with the buttons in #roles; made if missing.
# DISCORD_MERCHANT_ROLE=Merchant
# DISCORD_BUYER_ROLE=Buyer
# DISCORD_UPDATES_ROLE=Updates
# DISCORD_STATUS_ROLE=Status
# The status embed reads /api/status from here (default: the API on this
# machine, http://127.0.0.1:<PORT>) and refreshes every 5 minutes.
# DISCORD_API_URL=
# DISCORD_STATUS_INTERVAL_MS=300000
# What happens to whoever posts in the anti-bot channel: kick or ban.
# DISCORD_ANTIBOT_ACTION=kick
# Where the bot keeps panel ids, giveaways and warnings (default: <DATA_DIR>/discord.json).
# DISCORD_DATA_FILE=
