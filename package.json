{
  "name": "etheroute-api",
  "version": "1.0.0",
  "description": "Cryptocurrency SaaS platform for accepting invoices and processing payouts",
  "main": "src/app.js",
  "scripts": {
    "all": "node main.js",
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "build": "node scripts/build.js",
    "build:vendor": "node scripts/build-vendor.js",
    "migrate": "node scripts/migrate.js",
    "migrate:dry": "node scripts/migrate.js --dry-run",
    "test": "node --test tests/*.test.js",
    "chains:add": "node scripts/add-chain.js",
    "chains:verify": "node scripts/verify-chains.js",
    "chains:sync": "node scripts/sync-chain-copy.js",
    "chains:health": "node scripts/chain-health.js",
    "wallets:platform": "node scripts/platform-wallets.js",
    "fees:collect": "node scripts/collect-fees.js",
    "owner": "node scripts/owner.js",
    "discord": "node discord/index.js",
    "discord:channels": "node discord/scripts/channels.js",
    "telegram": "node telegram/index.js",
    "telegram:whoami": "node telegram/scripts/whoami.js"
  },
  "keywords": [
    "crypto",
    "etheroute",
    "blockchain",
    "ethereum",
    "bitcoin",
    "litecoin",
    "solana"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "axios": "^1.5.0",
    "bip32": "^5.0.1",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^7.0.1",
    "chart.js": "^4.4.0",
    "cors": "^2.8.6",
    "discord.js": "^14.27.0",
    "dotenv": "^16.3.1",
    "ed25519-hd-key": "^2.0.0",
    "ethers": "^6.16.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "highlight.js": "^11.9.0",
    "http-proxy-agent": "^7.0.0",
    "https-proxy-agent": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "qrcode": "^1.5.4",
    "tiny-secp256k1": "^2.2.4",
    "tweetnacl": "^1.0.3",
    "uuid": "^9.0.1",
    "xrpl": "^5.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
